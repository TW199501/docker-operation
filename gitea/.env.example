# =============================================================================
# Gitea 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh gitea
#
# 註解風格:本檔之前用 // C-style 註解(會被 bash source 當值的一部分),
#            已改為 # 同行註解。
# =============================================================================

# === Gitea Server ===
DOMAIN=gitea.example.com                       # 必填覆寫:你的網域
SSH_DOMAIN=gitea.example.com                   # 必填覆寫:SSH 網域
ROOT_URL="https://gitea.example.com/"          # 必填覆寫:對外 URL

# === Database (MSSQL) ===
DB_TYPE=mssql                                  # mysql / postgres / mssql / sqlite3
DB_HOST=                                       # 必填:DB 主機 IP / hostname
DB_PORT=1433                                   # MSSQL 預設
DB_NAME=gitea
DB_USER=gitea
DB_PASSWD=$(openssl rand -base64 24)           # 自動生成

# === Security ===
SECRET_KEY=$(openssl rand -hex 64)             # 全局加密金鑰

# === Access Control ===
DISABLE_REGISTRATION=false                     # true=只有管理員可建帳號
REQUIRE_SIGNIN_VIEW=false                      # true=強制登入才能看

# === Host User Mapping ===
USER_UID=1000                                  # 與 /data 卷擁有者 UID 一致
USER_GID=1001                                  # 與 /data 卷擁有者 GID 一致

# =============================================================================
# 初次部署的 SQL/Shell 操作(不是 .env 變數,留作參考)
# =============================================================================
#
# 1. 在 MSSQL 建 login + DB(密碼用上面 DB_PASSWD 的值)
#    CREATE LOGIN gitea WITH PASSWORD = '<your-DB_PASSWD>';
#    CREATE DATABASE gitea COLLATE Latin1_General_100_CI_AS_KS_WS_SC_UTF8;
#    USE gitea;
#    CREATE USER gitea FOR LOGIN gitea;
#    EXEC sp_addrolemember N'db_owner', N'gitea';
#
# 2. 在 host 建掛載目錄並設定權限
#    sudo mkdir -p /vol2/1000/hd-app/gitea/{data,config}
#    sudo chown -R 1000:1001 /vol2/1000/hd-app/gitea
