# =============================================================================
# Gitea Actions Runner 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh gitea/runner
# =============================================================================

INSTANCE_URL=                                  # 必填:Gitea 主機 URL,如 http://192.168.x.x:12350
REGISTRATION_TOKEN=                            # 必填:從 Gitea Admin Settings → Actions → Runners 取得
RUNNER_NAME=                                   # 必填:Runner 顯示名稱
RUNNER_LABELS=                                 # 必填:逗號分隔 labels,如 ubuntu-22.04,docker
