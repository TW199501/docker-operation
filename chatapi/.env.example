# =============================================================================
# ChatAPI 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh chatapi
# =============================================================================

API_PREFIX=                                    # 必填:API 路徑前綴
CHATGPT_BASE_URL=https://chatgpt.com
PROXY_URL=                                     # 必填(可逗號分隔多個):代理 URL
SCHEDULED_REFRESH=false

# === Coverage 補:compose.yml 用到但本檔原本未定義 ===
AUTHORIZATION=                                 # 必填:Bearer token / API key
SECRET_KEY=$(openssl rand -hex 32)             # 自動生成
