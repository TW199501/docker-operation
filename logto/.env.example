# =============================================================================
# Logto 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh logto
# =============================================================================

# === Proxy ===
TRUST_PROXY_HEADER=1                           # 1 = 信任 X-Forwarded-* header(後置 Nginx 用)

# === Database ===
# 格式:postgres://USER:PASSWORD@HOST:PORT/DB
# 不能用 $() 內嵌 — 整串 URL 必填,部署時組好填入
DB_URL=                                        # 必填:完整 PostgreSQL connection string

# === API 端點 ===
ENDPOINT=                                      # 必填:對外 API URL,如 https://auth.example.com
ADMIN_ENDPOINT=                                # 必填:管理 URL,如 https://auth-admin.example.com

# === 版本 ===
# TAG=1.33.0
