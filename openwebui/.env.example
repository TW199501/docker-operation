# =============================================================================
# Open WebUI 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh openwebui
# =============================================================================

ADMIN_EMAIL=                                   # 必填:管理員信箱(WebUI 首登登入用)
ADMIN_PASSWORD=$(openssl rand -base64 24)      # 自動生成
OLLAMA_BASE_URL=http://ollama:11434            # 同 stack 內可用 service name;對外需改
OPENAI_API_KEY=                                # 選填:接 OpenAI 才需要
