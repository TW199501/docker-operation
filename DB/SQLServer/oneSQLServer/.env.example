# =============================================================================
# MSSQL 2022 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh DB/SQLServer/oneSQLServer
# =============================================================================

MSSQL_CONTAINER_NAME=mssql2022-dev
MSSQL_SA_PASSWORD=$(openssl rand -base64 24)   # 自動生成(base64 含大小寫/數字/+-/,符合 MSSQL 複雜度)
MSSQL_PID=Developer
MSSQL_COLLATION=Chinese_Taiwan_Stroke_Count_100_CI_AS_SC_UTF8
MSSQL_AGENT_ENABLED=true
MSSQL_TLS_CIPHER_SUITES="TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256"
TZ=Asia/Taipei
MSSQL_HOST_PORT=1433

# === 路徑 ===(改用合法路徑或保持空值由部署環境注入)
MSSQL_DATA_DIR_HOST=                           # 必填:host 上 data 目錄絕對路徑
MSSQL_CERT_DIR_HOST=                           # 必填:host 上 cert 目錄絕對路徑

# === 資源限制 ===
MSSQL_LIMIT_CPU=4.0
MSSQL_LIMIT_MEM=12G
MSSQL_RESERVE_CPU=2.0
MSSQL_RESERVE_MEM=6G
