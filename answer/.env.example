# =============================================================================
# Apache Answer 環境變數範本
# 規範:docs/conventions/env-naming.md
# 用法:./scripts/env/bootstrap-env.sh answer
# =============================================================================

# === 安裝 ===
INSTALL_PORT=80
AUTO_INSTALL=true

# === 資料庫(MySQL/Postgres,sqlite3 則只看 DB_FILE)===
DB_TYPE=sqlite3                                # sqlite3 / mysql / postgres
DB_USERNAME=answer_user
DB_PASSWORD=$(openssl rand -base64 32)         # 自動生成
DB_HOST=127.0.0.1:3306
DB_NAME=answer_db
DB_FILE=/data/answer.db                        # SQLite 檔案路徑(僅 sqlite3 用)

# === 網站基本 ===
LANGUAGE=zh-TW
SITE_NAME="Apache Answer"
SITE_URL=                                      # 必填:對外網址
CONTACT_EMAIL=                                 # 必填:聯絡信箱

# === 管理員 ===
ADMIN_NAME=admin
ADMIN_PASSWORD=$(openssl rand -base64 24)      # 自動生成
ADMIN_EMAIL=                                   # 必填:管理員信箱

# === 顯示設定 ===
EXTERNAL_CONTENT_DISPLAY=always_display

# === Swagger ===
SWAGGER_HOST=                                  # 必填:Swagger 顯示的主機
SWAGGER_ADDRESS_PORT=:3000

# === 伺服器與日誌 ===
SITE_ADDR=0.0.0.0:3000
LOG_LEVEL=INFO
LOG_PATH=/var/log/answer/
